---
import { Image } from "astro:assets";
import SiteNav from "../components/SiteNav.astro";
import SiteFooter from "../components/SiteFooter.astro";
import matterhornImage from "../assets/matterhorn-hero-v1.png";
import "@fontsource-variable/lora";
import "@fontsource-variable/lora/wght-italic.css";
import "@fontsource-variable/raleway";
import "../styles/wetland-preview.css";
import "../styles/scrollbar.css";

const socialImage = new URL(matterhornImage.src, Astro.site ?? Astro.url.origin).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0c4a49" />
    <meta
      name="description"
      content="A software engineer and researcher building thoughtful systems across AI, infrastructure, and product engineering."
    />
    <meta property="og:title" content="Peter Tran" />
    <meta
      property="og:description"
      content="Software engineer and researcher building thoughtful systems across AI, infrastructure, and product engineering."
    />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={socialImage} />
    <title>Peter Tran</title>
  </head>

  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>

    <div class="hero">
      <Image
        class="hero__art"
        src={matterhornImage}
        alt=""
        aria-hidden="true"
        loading="eager"
        decoding="sync"
        fetchpriority="high"
        widths={[768, 1200, 1672]}
        sizes="100vw"
        quality={88}
      />
      <div class="hero__veil" aria-hidden="true"></div>

      <SiteNav overlay />

      <main id="main-content" class="hero__content shell" tabindex="-1">
        <h1 id="hero-title">Software engineer and computer science researcher.</h1>
        <p class="hero__lede">
          I study computer science with a mathematics minor at UT Arlington.
          Currently conducting deep learning undergraduate research with DIAL Labs on inductive
          graph link prediction.
        </p>
        <div class="hero__details">
          <p>
            former swe intern at <strong>JP Morgan Chase</strong> focused on agentic workflow
            development & infrastructure.
          </p>
          <p>
            previously a sde intern at <strong>Aereos</strong> building cloud infrastructure & IoT
            firmware.
          </p>
          <p>
            started as an it intern at <strong>Mansfield ISD Technology</strong> working on software
            and hardware troubleshooting.
          </p>
          <p>I’m interested in AI, distributed systems, infrastructure, and developer tools.</p>
          <p>Outside of software, I run, play volleyball, and take photos.</p>
        </div>
      </main>
    </div>

    <SiteFooter />
  </body>
</html>
