---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import SiteNav from "../components/SiteNav.astro";
import matterhornImage from "../assets/matterhorn-hero-v1.png";
import "@fontsource-variable/lora";
import "@fontsource-variable/lora/wght-italic.css";
import "@fontsource-variable/raleway";
import "../styles/wetland-preview.css";
import "../styles/scrollbar.css";

const posts = (await getCollection("blog"))
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 3);

const socialImage = new URL(matterhornImage.src, Astro.site ?? Astro.url.origin).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#082f31" />
    <meta
      name="description"
      content="Peter Tran is a software engineer and researcher building thoughtful systems across AI, infrastructure, and product engineering."
    />
    <meta property="og:title" content="Peter Tran" />
    <meta
      property="og:description"
      content="Software engineer and researcher building thoughtful systems across AI, infrastructure, and product engineering."
    />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={socialImage} />
    <title>Peter Tran · Software engineer and researcher</title>
    <script is:inline>
      document.documentElement.classList.add("js");
      window.__portfolioRevealFallback = window.setTimeout(() => {
        document.documentElement.classList.add("reveal-fallback");
      }, 2500);
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>

    <header class="hero" aria-labelledby="hero-title" data-browser-color="#082f31">
      <Image
        class="hero__art"
        src={matterhornImage}
        alt=""
        aria-hidden="true"
        loading="eager"
        decoding="sync"
        fetchpriority="high"
        widths={[768, 1200, 1672]}
        sizes="100vw"
        quality={88}
      />
      <div class="hero__veil" aria-hidden="true"></div>

      <SiteNav overlay />

      <div class="hero__content shell">
        <p class="eyebrow eyebrow--light reveal">Software engineer · Researcher</p>
        <h1 id="hero-title" class="reveal reveal--delay-1">
          I build software for systems with <em>a lot going on.</em>
        </h1>
        <p class="hero__lede reveal reveal--delay-2">
          From AI and distributed infrastructure to one very opinionated
          houseplant, I like turning complicated systems into things people can
          understand and trust.
        </p>
        <p class="hero__meta reveal reveal--delay-3">
          Computer Science · Mathematics minor · UT Arlington · Class of ’27
        </p>
      </div>

    </header>

    <main id="main-content" tabindex="-1" data-browser-color="#f7f3e8">
      <section class="manifesto shell section-space reveal" aria-labelledby="manifesto-title">
        <div>
          <p class="eyebrow">01 · Approach</p>
        </div>
        <div class="manifesto__copy">
          <h2 id="manifesto-title">Complex systems can still feel human.</h2>
          <div class="manifesto__columns">
            <p>
              I enjoy finding the shape inside a messy problem, tracing how the
              pieces connect, testing the risky edges, and building something
              calm enough that the complexity no longer gets in the way.
            </p>
            <p>
              My work moves between infrastructure, AI, product engineering,
              and research. The thread through all of it is curiosity, care,
              and software that survives contact with the real world.
            </p>
          </div>
        </div>
      </section>

      <section id="work" class="work-section shell section-space" aria-labelledby="work-title">
        <div class="section-heading reveal">
          <div>
            <p class="eyebrow">02 · Selected work</p>
            <h2 id="work-title">A few things I’ve made</h2>
          </div>
          <p>Experiments in making complicated systems more tangible.</p>
        </div>

        <ol class="project-list" role="list">
          <li class="project reveal">
            <div class="project__number" aria-hidden="true">01</div>
            <div class="project__body">
              <div class="project__meta">
                <span>AI + embedded systems</span>
                <span>Open Model Hackathon</span>
              </div>
              <h3>Plant-Pal</h3>
              <p class="project__tagline">
                Giving a houseplant a voice, one soil reading at a time.
              </p>
              <p class="project__description">
                An ESP32 reads soil moisture and humidity, gpt-oss-20b decides
                how the plant feels, and Discord delivers the complaints.
              </p>
              <ul class="project__stack" role="list" aria-label="Technologies used">
                <li>ESP32</li>
                <li>Python</li>
                <li>gpt-oss-20b</li>
                <li>Discord</li>
              </ul>
              <div class="project__links">
                <a href="https://github.com/Peter-Phi-Tran/Plant-Pal">View code</a>
                <a href="https://devpost.com/software/ai-caramba">Devpost</a>
              </div>
            </div>
          </li>

          <li class="project reveal">
            <div class="project__number" aria-hidden="true">02</div>
            <div class="project__body">
              <div class="project__meta">
                <span>Distributed backend</span>
                <span>Independent build</span>
              </div>
              <h3>Serapis</h3>
              <p class="project__tagline">
                Learning the machinery behind a production backend.
              </p>
              <p class="project__description">
                A patient-management system with containerized services for
                authentication and analytics, connected through gRPC and Kafka,
                with AWS infrastructure simulated locally.
              </p>
              <ul class="project__stack" role="list" aria-label="Technologies used">
                <li>Spring Boot</li>
                <li>Kafka</li>
                <li>gRPC</li>
                <li>LocalStack</li>
              </ul>
            </div>
          </li>

          <li class="project reveal">
            <div class="project__number" aria-hidden="true">03</div>
            <div class="project__body">
              <div class="project__meta">
                <span>Multi-agent experience</span>
                <span>HackTX</span>
              </div>
              <h3>Tachyon</h3>
              <p class="project__tagline">
                Turning car-financing trade-offs into something you can explore.
              </p>
              <p class="project__description">
                A three-agent interview translates competing priorities into an
                interactive 3D constellation instead of another spreadsheet to
                dread.
              </p>
              <ul class="project__stack" role="list" aria-label="Project characteristics">
                <li>Multi-agent</li>
                <li>3D web</li>
                <li>Data visualization</li>
              </ul>
              <div class="project__links">
                <a href="https://devpost.com/software/tachyon-ruiz5h">View on Devpost</a>
              </div>
            </div>
          </li>
        </ol>

        <p class="archive-link reveal">
          More experiments live in
          <a href="https://github.com/peterphitran">the archive</a>.
        </p>
      </section>

      <section
        id="experience"
        class="journey section-space"
        aria-labelledby="experience-title"
        data-browser-color="#0c4a49"
      >
        <div class="journey__texture" aria-hidden="true"></div>
        <div class="shell">
          <div class="section-heading section-heading--light reveal">
            <div>
              <p class="eyebrow eyebrow--light">03 · Along the path</p>
              <h2 id="experience-title">Where I’ve worked</h2>
            </div>
            <p>Learning by building, researching, and shipping alongside good people.</p>
          </div>

          <ol class="timeline" role="list">
            <li class="reveal">
              <div class="timeline__marker" aria-hidden="true"><span></span></div>
              <time datetime="2026">Summer 2026</time>
              <h3>JPMorgan Chase</h3>
            </li>
            <li class="reveal">
              <div class="timeline__marker" aria-hidden="true"><span></span></div>
              <time datetime="2026">Summer 2026</time>
              <h3>DIAL Labs · UT Arlington</h3>
            </li>
            <li class="reveal">
              <div class="timeline__marker" aria-hidden="true"><span></span></div>
              <span class="timeline__date">May 2025 – May 2026</span>
              <h3>Beautisol</h3>
            </li>
            <li class="reveal">
              <div class="timeline__marker" aria-hidden="true"><span></span></div>
              <span class="timeline__date">2022 – 2023</span>
              <h3>MISD Technology</h3>
            </li>
          </ol>
        </div>
      </section>

      <section id="notes" class="notes shell section-space" aria-labelledby="notes-title">
        <div class="notes__intro reveal">
          <p class="eyebrow">04 · Dispatches</p>
          <h2 id="notes-title">Notes from the work</h2>
          <p>
            What I’m building, what broke, and what the detour taught me.
          </p>
          <a class="text-link" href="/blog">Read all field notes</a>
        </div>

        <ol class="note-list" role="list">
          {posts.map((post, index) => (
            <li class="reveal">
              <a href={`/blog/${post.slug}`}>
                <div class="note-list__meta">
                  <span>{String(index + 1).padStart(2, "0")}</span>
                  <time datetime={post.data.date}>
                    {new Date(post.data.date).toLocaleDateString("en-US", {
                      month: "short",
                      day: "numeric",
                      year: "numeric",
                      timeZone: "UTC",
                    })}
                  </time>
                </div>
                <h3>{post.data.title}</h3>
                <p>{post.data.excerpt}</p>
              </a>
            </li>
          ))}
        </ol>
      </section>

    </main>

    <footer id="contact" class="footer" data-browser-color="#082f31">
      <div class="footer__glow" aria-hidden="true"></div>
      <div class="shell footer__inner reveal">
        <div class="footer__bottom">
          <p class="signature">peter</p>
          <nav aria-label="Contact and social links">
            <a class="footer__social" href="mailto:ptran.tech@outlook.com" aria-label="Email" title="Email">
              <Icon class="footer__icon" name="fa7-solid:envelope" aria-hidden="true" />
            </a>
            <a class="footer__social" href="https://github.com/peterphitran" aria-label="GitHub" title="GitHub">
              <Icon class="footer__icon" name="devicon:github" aria-hidden="true" />
            </a>
            <a class="footer__social" href="https://www.linkedin.com/in/peter-phi-tran/" aria-label="LinkedIn" title="LinkedIn">
              <Icon class="footer__icon footer__icon--linkedin" name="devicon:linkedin" aria-hidden="true" />
            </a>
            <a class="footer__social" href="/gallery" aria-label="Gallery" title="Gallery">
              <Icon class="footer__icon" name="fa7-solid:images" aria-hidden="true" />
            </a>
          </nav>
          <p class="footer__fine">Computer science · UT Arlington · Class of 2027</p>
        </div>
      </div>
    </footer>

    <script>
      const revealWindow = window as Window & { __portfolioRevealFallback?: number };
      if (revealWindow.__portfolioRevealFallback) {
        window.clearTimeout(revealWindow.__portfolioRevealFallback);
      }

      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const reveals = document.querySelectorAll<HTMLElement>(".reveal");

      if (reduceMotion || !("IntersectionObserver" in window)) {
        reveals.forEach((element) => element.classList.add("is-visible"));
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            });
          },
          { threshold: 0.12, rootMargin: "0px 0px -8%" }
        );

        reveals.forEach((element) => observer.observe(element));
      }

      const browserTheme = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');
      let browserThemeFrame: number | undefined;

      const syncBrowserTheme = () => {
        if (!browserTheme || browserThemeFrame !== undefined) return;

        browserThemeFrame = window.requestAnimationFrame(() => {
          browserThemeFrame = undefined;
          const surface = document
            .elementFromPoint(window.innerWidth / 2, window.innerHeight / 2)
            ?.closest<HTMLElement>("[data-browser-color]");
          const color = surface?.dataset.browserColor;

          if (color && browserTheme.content !== color) {
            browserTheme.content = color;
          }
        });
      };

      window.addEventListener("scroll", syncBrowserTheme, { passive: true });
      window.addEventListener("resize", syncBrowserTheme, { passive: true });
      window.addEventListener("pageshow", syncBrowserTheme);
      syncBrowserTheme();
    </script>
  </body>
</html>
