---
import { Image } from "astro:assets";
import SiteNav from "../components/SiteNav.astro";
import SiteFooter from "../components/SiteFooter.astro";
import matterhornImage from "../assets/matterhorn-hero-v1.png";
import "@fontsource-variable/ysabeau";
import "@fontsource-variable/ysabeau-office";
import "@fontsource-variable/ysabeau-sc";
import "../styles/wetland-preview.css";
import "../styles/scrollbar.css";

const socialImage = new URL(matterhornImage.src, Astro.site ?? Astro.url.origin).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0c4a49" />
    <meta
      name="description"
      content="A software engineer and researcher building thoughtful systems across AI, infrastructure, and product engineering."
    />
    <meta property="og:title" content="Peter Tran" />
    <meta
      property="og:description"
      content="Software engineer and researcher building thoughtful systems across AI, infrastructure, and product engineering."
    />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={socialImage} />
    <title>Peter Tran</title>
  </head>

  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>

    <div class="hero">
      <Image
        class="hero__art"
        src={matterhornImage}
        alt=""
        aria-hidden="true"
        loading="eager"
        decoding="sync"
        fetchpriority="high"
        widths={[768, 1200, 1672]}
        sizes="100vw"
        quality={88}
      />
      <div class="hero__veil" aria-hidden="true"></div>

      <SiteNav overlay showHome={false} />

      <main id="main-content" class="hero__content shell" tabindex="-1">
        <h1 id="hero-title">Peter Tran</h1>
        <p class="hero__title">Computer Science &amp; Mathematics, UT Arlington</p>
        <p class="hero__summary">
          Graph link prediction research with DIAL Labs. Previously JP Morgan Chase, Aereos,
          Mansfield ISD.
        </p>
        <p class="hero__summary">
          My current interests are inference engineering, reinforcement learning, mechinterp,
          multimodal ai security, and translational bioinformatics.
        </p>
      </main>
    </div>

    <SiteFooter />
  </body>
</html>
