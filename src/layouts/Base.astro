---
// Base.astro — shared shell for every page.
import "../styles/theme.css";
import "../styles/scrollbar.css";
import "@fontsource-variable/lora";
import "@fontsource-variable/lora/wght-italic.css";
import "@fontsource-variable/raleway";
import SiteNav from "../components/SiteNav.astro";
import SiteFooter from "../components/SiteFooter.astro";

interface Props {
  title: string;
  description?: string;
  wide?: boolean;
}

const {
  title,
  description = "Peter Tran, a CS student at UT Arlington building software that survives the real world.",
  wide = false,
} = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title === "Home" ? "Peter Tran" : `${title} · Peter Tran`}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0c4a49" />
    <meta property="og:title" content="Peter Tran" />
    <meta property="og:description" content={description} />
    <!-- TODO: replace with a real social image in /public -->
    <meta property="og:image" content="/og.png" />
  </head>

  <body class="interior-page">
    <a class="skip-link" href="#main-content">Skip to content</a>
    <SiteNav />
    <div class={wide ? "page page--wide" : "page"}>
      <main id="main-content" tabindex="-1">
        <slot />
      </main>
    </div>
    <SiteFooter />
  </body>
</html>
