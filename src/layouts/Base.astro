---
// Base.astro — shared shell for every page.
import "../styles/theme.css";
import "../styles/scrollbar.css";
import "@fontsource-variable/ysabeau";
import "@fontsource-variable/ysabeau/wght-italic.css";
import "@fontsource-variable/ysabeau-office";
import "@fontsource-variable/ysabeau-office/wght-italic.css";
import "@fontsource-variable/ysabeau-sc";
import matterhornImage from "../assets/matterhorn-hero-v1.png";
import PageHero from "../components/PageHero.astro";
import SiteNav from "../components/SiteNav.astro";
import SiteFooter from "../components/SiteFooter.astro";

interface HeroOptions {
  intro: string;
  compact?: boolean;
  /** Which area of the painting the hero washes into color (varies per page). */
  wash?: number;
}

interface Props {
  title: string;
  description?: string;
  wide?: boolean;
  reading?: boolean;
  hero?: HeroOptions;
}

const {
  title,
  description = "Peter Tran, a CS student at UT Arlington building software that survives the real world.",
  wide = false,
  reading = false,
  hero,
} = Astro.props;
const socialImage = new URL(matterhornImage.src, Astro.site ?? Astro.url.origin).toString();
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title === "Home" ? "Peter Tran" : `${title} · Peter Tran`}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0c4a49" />
    <meta property="og:title" content="Peter Tran" />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImage} />
  </head>

  <body class:list={["interior-page", { "interior-page--backdrop": hero }]}>
    <a class="skip-link" href="#main-content">Skip to content</a>
    {hero ? (
      <PageHero
        title={title}
        intro={hero.intro}
        wide={wide}
        compact={hero.compact}
        wash={hero.wash}
      />
    ) : (
      <SiteNav compact={reading} />
    )}
    <div
      class:list={[
        "page",
        {
          "page--wide": wide,
          "page--reading": reading,
          "page--with-hero": hero,
          "page--with-compact-hero": hero?.compact,
        },
      ]}
    >
      <main id="main-content" tabindex="-1">
        <slot />
      </main>
    </div>
    <SiteFooter transparent={Boolean(hero)} />
  </body>
</html>
