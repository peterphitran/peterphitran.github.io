---
import { Icon } from "astro-icon/components";

interface Props {
  transparent?: boolean;
}

interface FooterLink {
  label: string;
  href: string;
  icon: string;
  iconClass?: string;
}

const { transparent = false } = Astro.props;

const links: FooterLink[] = [
  {
    label: "Email",
    href: "mailto:ptran.tech@outlook.com",
    icon: "fa7-solid:envelope",
  },
  {
    label: "GitHub",
    href: "https://github.com/peterphitran",
    icon: "devicon:github",
  },
  {
    label: "LinkedIn",
    href: "https://www.linkedin.com/in/peter-phi-tran/",
    icon: "devicon:linkedin",
    iconClass: "social-icon--linkedin",
  },
  {
    label: "Gallery",
    href: "/gallery",
    icon: "fa7-solid:images",
  },
  {
    label: "Beli",
    href: "https://beliapp.co/app/ptran13",
    icon: "fa7-solid:utensils",
  },
];
---

<footer id="contact" class:list={["site-footer", { "site-footer--transparent": transparent }]}>
  <div class="site-footer__inner">
    <nav aria-label="Contact and social links">
      {links.map((link) => (
        <a href={link.href} aria-label={link.label} title={link.label}>
          <Icon
            class:list={["social-icon", link.iconClass]}
            name={link.icon}
            aria-hidden="true"
          />
        </a>
      ))}
    </nav>
    <p class="site-footer__fine">doing hard things for the love of the game</p>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    overflow: hidden;
    padding: 2rem 0 calc(3rem + env(safe-area-inset-bottom, 0px));
    background: var(--page-background, #0c4a49);
    color: #fffdf4;
  }

  .site-footer--transparent {
    padding-top: 0;
    background: transparent;
  }

  .site-footer__inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    width: min(1180px, calc(100% - 64px));
    margin-inline: auto;
    padding-top: 2rem;
    align-items: center;
    gap: 2rem;
    border-top: 1px solid rgba(255, 253, 244, 0.17);
  }

  nav {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  nav a {
    display: inline-grid;
    width: 44px;
    height: 44px;
    place-items: center;
    color: rgba(255, 253, 244, 0.58);
    text-decoration: none;
  }

  nav a:hover {
    color: #fffdf4;
  }

  nav a:focus-visible {
    outline: 2px solid var(--pen-strong);
    outline-offset: 3px;
    border-radius: 4px;
  }

  .social-icon {
    width: 1.15rem;
    height: 1.15rem;
    flex: none;
    filter: brightness(0) invert(1);
    opacity: 0.58;
    transition: opacity 180ms ease;
  }

  .social-icon--linkedin {
    filter: grayscale(1) saturate(0) brightness(1.45) contrast(1.15);
    opacity: 0.72;
  }

  nav a:hover .social-icon {
    opacity: 1;
  }

  .site-footer__fine {
    justify-self: end;
    margin: 0;
    color: rgba(255, 253, 244, 0.58);
    font-family: "Raleway Variable", "Helvetica Neue", Arial, sans-serif;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
  }

  @media (max-width: 1020px) {
    .site-footer__inner {
      grid-template-columns: 1fr auto;
    }

    .site-footer__fine {
      grid-column: 1 / -1;
      justify-self: start;
    }
  }

  @media (max-width: 800px) {
    .site-footer__inner {
      width: min(100% - 40px, 680px);
    }
  }

  @media (max-width: 560px) {
    .site-footer__inner {
      grid-template-columns: 1fr;
      width: calc(100% - 32px);
      gap: 1rem;
    }

    nav {
      flex-wrap: wrap;
      gap: 0.35rem;
    }

    .site-footer__fine {
      grid-column: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .social-icon {
      transition: none;
    }
  }
</style>
