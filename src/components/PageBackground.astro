---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  image: ImageMetadata;
  position?: string;
  mobilePosition?: string;
}

const { image, position = "center", mobilePosition = position } = Astro.props;
const candidateWidths = [640, 960, 1200, 1536, 1672];
const widths = [...new Set([...candidateWidths.filter((width) => width <= image.width), image.width])];
---

<div
  class="page-background"
  style={`--page-background-position: ${position}; --page-background-position-mobile: ${mobilePosition};`}
  aria-hidden="true"
>
  <Image
    class="page-background__art"
    src={image}
    alt=""
    loading="eager"
    decoding="async"
    fetchpriority="high"
    widths={widths}
    sizes="100vw"
    quality={86}
  />
  <div class="page-background__veil"></div>
</div>

<style>
  .page-background {
    position: fixed;
    z-index: 0;
    inset: 0;
    width: 100%;
    height: 100vh;
    height: 100dvh;
    overflow: hidden;
    background: var(--page-background, #0c4a49);
    pointer-events: none;
  }

  .page-background__art {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--page-background-position);
  }

  .page-background__veil {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(4, 28, 30, 0.58), rgba(4, 28, 30, 0.74)),
      linear-gradient(90deg, rgba(5, 35, 38, 0.82) 0%, rgba(5, 40, 42, 0.56) 48%, rgba(7, 44, 43, 0.34) 100%);
  }

  @media (max-width: 800px) {
    .page-background__art {
      object-position: var(--page-background-position-mobile);
    }

    .page-background__veil {
      background:
        linear-gradient(180deg, rgba(4, 28, 30, 0.62), rgba(4, 28, 30, 0.8)),
        linear-gradient(90deg, rgba(5, 35, 38, 0.72), rgba(5, 39, 40, 0.46));
    }
  }
</style>
