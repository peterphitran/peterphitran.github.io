---
import { getImage } from "astro:assets";
import matterhornImage from "../assets/matterhorn-hero-v1.png";

interface Props {
  overlay?: boolean;
  compact?: boolean;
  variant?: "default" | "links-only";
}

const { overlay = false, compact = false, variant = "default" } = Astro.props;
const path = Astro.url.pathname;
const links = [
  { label: "projects", href: "/projects" },
  { label: "gallery", href: "/gallery" },
  { label: "blog", href: "/blog" },
  { label: "topics", href: "/topics" },
];

const current = (href: string) =>
  path === href || path.startsWith(`${href}/`) ? "page" : undefined;

// Small, blurred copy of the painting behind the phone menu.
const menuBackdrop = await getImage({
  src: matterhornImage,
  width: 640,
  format: "webp",
  quality: 60,
});
---

<header
  class:list={[
    "portfolio-nav",
    {
      "portfolio-nav--overlay": overlay,
      "portfolio-nav--compact": compact,
      "portfolio-nav--links-only": variant === "links-only",
    },
  ]}
  data-site-nav
>
  <div class="portfolio-nav__inner">
    {variant === "default" && (
      <a class="portfolio-nav__wordmark" href="/" aria-label="Peter Tran, home">
        peter tran
      </a>
    )}
    <nav class="portfolio-nav__links" aria-label="Primary navigation">
      {links.map((link) => (
        <a href={link.href} aria-current={current(link.href)}>{link.label}</a>
      ))}
    </nav>
    <button
      class="portfolio-nav__toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-menu"
      aria-label="Open menu"
      data-menu-toggle
    >
      menu
    </button>
  </div>

  <dialog
    id="site-menu"
    class="site-menu"
    aria-label="Site menu"
    style={`--menu-backdrop: url("${menuBackdrop.src}")`}
    data-menu
  >
    <button class="site-menu__close" type="button" aria-label="Close menu" data-menu-close>close</button>
    <nav aria-label="Menu">
      {links.map((link) => (
        <a href={link.href} aria-current={current(link.href)}>{link.label}</a>
      ))}
    </nav>
  </dialog>
</header>
<script is:inline>if (window.HTMLDialogElement) document.currentScript.previousElementSibling.classList.add("portfolio-nav--js");</script>

<script>
  const nav = document.querySelector<HTMLElement>("[data-site-nav]");
  const toggle = nav?.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const menu = nav?.querySelector<HTMLDialogElement>("[data-menu]");
  const closeButton = menu?.querySelector<HTMLButtonElement>("[data-menu-close]");

  if (nav && toggle && menu && closeButton) {
    const phone = window.matchMedia("(max-width: 560px)");
    const menuLinks = () => Array.from(menu.querySelectorAll<HTMLAnchorElement>("a"));
    let closedByLink = false;

    toggle.addEventListener("click", () => {
      if (menu.open) return;
      closedByLink = false;
      menu.showModal();
      toggle.setAttribute("aria-expanded", "true");
      document.documentElement.style.overflow = "hidden";
      const rect = toggle.getBoundingClientRect();
      closeButton.style.top = `${Math.max(rect.top, 0)}px`;
      closeButton.style.right = `${window.innerWidth - rect.right}px`;
      closeButton.style.height = `${rect.height}px`;
      menuLinks()[0]?.focus();
    });

    closeButton.addEventListener("click", () => menu.close());

    menu.addEventListener("click", (event) => {
      if ((event.target as Element).closest("a")) {
        closedByLink = true;
        menu.close();
      }
    });

    menu.addEventListener("keydown", (event) => {
      if (event.key !== "Tab") return;
      const items = [closeButton, ...menuLinks()];
      const first = items[0];
      const last = items[items.length - 1];
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    });

    menu.addEventListener("close", () => {
      toggle.setAttribute("aria-expanded", "false");
      document.documentElement.style.overflow = "";
      if (!closedByLink) toggle.focus();
      closedByLink = false;
    });

    phone.addEventListener("change", (event) => {
      if (!event.matches && menu.open) menu.close();
    });
  }
</script>

<style>
  .portfolio-nav {
    position: relative;
    z-index: 20;
    width: 100%;
    padding-top: env(safe-area-inset-top, 0px);
    color: #fffdf4;
    font-family: "Ysabeau SC Variable", "Helvetica Neue", Arial, sans-serif;
    font-weight: 500;
    letter-spacing: 0.14em;
  }

  .portfolio-nav:not(.portfolio-nav--overlay) {
    margin-bottom: clamp(4rem, 9vw, 7rem);
  }

  .portfolio-nav--compact:not(.portfolio-nav--overlay) {
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .portfolio-nav--overlay {
    position: absolute;
    top: 0;
    right: 0;
    left: 0;
  }

  .portfolio-nav__inner {
    display: flex;
    width: min(1180px, calc(100% - 64px));
    min-height: 92px;
    margin-inline: auto;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px solid rgba(255, 253, 244, 0.18);
  }

  .portfolio-nav--links-only .portfolio-nav__inner {
    justify-content: center;
    border-bottom-color: transparent;
  }

  .portfolio-nav__wordmark {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    color: #fffdf4;
    font-size: 0.95rem;
    text-decoration: none;
  }

  .portfolio-nav__links {
    display: flex;
    align-items: center;
    gap: 1.6rem;
    font-size: 0.85rem;
  }

  .portfolio-nav__links a {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    border-bottom: 1px solid transparent;
    color: rgba(255, 253, 244, 0.82);
    text-decoration: none;
    transition: border-color 160ms ease, color 160ms ease;
  }

  .portfolio-nav__links a:hover {
    color: var(--pen-strong);
  }

  .portfolio-nav__links a[aria-current="page"] {
    border-bottom-color: var(--pen);
    color: #fffdf4;
  }

  .portfolio-nav__toggle {
    display: none;
    min-height: 44px;
    margin-left: auto;
    padding: 0 0.25rem;
    border: 0;
    background: none;
    color: #fffdf4;
    font: inherit;
    font-size: 0.95rem;
    letter-spacing: inherit;
    cursor: pointer;
  }

  :is(.portfolio-nav__wordmark, .portfolio-nav__links a, .portfolio-nav__toggle, .site-menu__close, .site-menu a):focus-visible {
    outline: 2px solid var(--pen-strong);
    outline-offset: 3px;
    border-radius: 4px;
  }

  .site-menu {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    border: 0;
    align-items: flex-end;
    padding: 0 20px calc(3rem + env(safe-area-inset-bottom, 0px));
    overflow: hidden;
    background: #0c4a49;
    color: #fffdf4;
    isolation: isolate;
    animation: site-menu-in 160ms ease both;
  }

  .site-menu[open] {
    display: flex;
  }

  .site-menu::backdrop {
    background: transparent;
  }

  .site-menu__close {
    position: absolute;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 0.25rem;
    border: 0;
    background: none;
    color: #fffdf4;
    font: inherit;
    font-size: 0.95rem;
    letter-spacing: 0.14em;
    cursor: pointer;
  }

  .site-menu::before {
    position: absolute;
    z-index: -2;
    inset: -32px;
    background: var(--menu-backdrop) 74% center / cover no-repeat;
    content: "";
    filter: blur(12px);
  }

  .site-menu::after {
    position: absolute;
    z-index: -1;
    inset: 0;
    background: rgba(5, 30, 32, 0.55);
    content: "";
  }

  .site-menu nav {
    display: flex;
    flex-direction: column;
    font-size: 1.5rem;
    font-weight: 400;
    letter-spacing: 0.1em;
    line-height: 1.55;
  }

  .site-menu a {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    color: #fffdf4;
    text-decoration: none;
  }

  .site-menu a[aria-current="page"] {
    color: var(--pen, #b7d7a5);
  }

  @keyframes site-menu-in {
    from {
      opacity: 0;
    }

    to {
      opacity: 1;
    }
  }

  @media (max-width: 800px) {
    .portfolio-nav__inner {
      width: min(100% - 40px, 680px);
    }
  }

  @media (max-width: 560px) {
    .portfolio-nav__inner {
      width: calc(100% - 32px);
      min-height: 118px;
      padding-block: 0.7rem;
      align-items: flex-start;
      flex-direction: column;
      justify-content: center;
      gap: 0.1rem;
    }

    .portfolio-nav__links {
      width: 100%;
      flex-wrap: wrap;
      gap: 0.2rem 1.3rem;
      font-size: 0.8rem;
    }

    .portfolio-nav--js .portfolio-nav__inner {
      min-height: 72px;
      padding-block: 0;
      align-items: center;
      flex-direction: row;
      justify-content: space-between;
    }

    .portfolio-nav--js.portfolio-nav--links-only .portfolio-nav__inner {
      justify-content: flex-end;
    }

    .portfolio-nav--js .portfolio-nav__links {
      display: none;
    }

    .portfolio-nav--js .portfolio-nav__toggle {
      display: inline-flex;
      align-items: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .portfolio-nav__links a {
      transition: none;
    }

    .site-menu {
      animation: none;
    }
  }
</style>
