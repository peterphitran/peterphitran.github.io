---
import { getImage } from "astro:assets";
import SiteNav from "./SiteNav.astro";
import matterhornImage from "../assets/matterhorn-hero-v1.png";

interface Props {
  title: string;
  intro: string;
  wide?: boolean;
  compact?: boolean;
  wash?: number;
}

const { title, intro, wide = false, compact = false, wash = 0 } = Astro.props;

// Each page washes a different area of the landing painting into soft color:
// the summit, the forest slope, the sunlit sky, the snowy face.
const washPositions = ["72% 8%", "98% 96%", "100% 0%", "62% 52%"];
const washPosition = washPositions[Math.abs(wash) % washPositions.length];

// Heavily blurred, so a small copy is plenty.
const washImage = await getImage({
  src: matterhornImage,
  width: 960,
  format: "webp",
  quality: 60,
});
---

<header
  class:list={["page-hero", { "page-hero--compact": compact }]}
  aria-labelledby="page-hero-title"
>
  <div
    class="page-hero__wash"
    style={`background-image: url("${washImage.src}"); background-position: ${washPosition};`}
    aria-hidden="true"
  ></div>

  <SiteNav overlay />

  <div class:list={["page-hero__content", { "page-hero__content--wide": wide }]}>
    <h1 id="page-hero-title">{title}</h1>
    <p>{intro}</p>
  </div>
</header>

<style>
  .page-hero {
    position: relative;
    z-index: 1;
    isolation: isolate;
    overflow: hidden;
    display: grid;
    min-height: clamp(31rem, 60svh, 42rem);
    color: #fffdf4;
  }

  /* A zoomed-in area of the painting, blurred into abstract color. Oversized so the
     blur's soft edges stay off-screen. */
  .page-hero__wash {
    position: absolute;
    z-index: -2;
    inset: -120px;
    background-repeat: no-repeat;
    background-size: 320%;
    filter: blur(60px) saturate(1.1) brightness(0.85);
    pointer-events: none;
  }

  /* Nav and title shading, plus a fade into the page teal so the hero ends seamlessly. */
  .page-hero::before {
    position: absolute;
    z-index: -1;
    inset: 0;
    /* The teal fade is listed first so it paints on top and the hero ends exactly on
       the page color, with no seam. */
    background:
      linear-gradient(180deg, transparent 55%, var(--page-background, #0c4a49) 100%),
      linear-gradient(180deg, rgba(5, 33, 34, 0.45) 0%, transparent 22%),
      linear-gradient(25deg, rgba(5, 30, 32, 0.6) 0%, transparent 55%);
    content: "";
    pointer-events: none;
  }

  .page-hero__content {
    align-self: end;
    width: min(760px, calc(100% - 64px));
    margin-inline: auto;
    padding: 10rem 0 clamp(5.5rem, 10vw, 8rem);
  }

  .page-hero__content--wide {
    width: min(1080px, calc(100% - 64px));
  }

  .page-hero--compact {
    min-height: clamp(24rem, 46svh, 30rem);
  }

  .page-hero--compact .page-hero__content {
    padding-bottom: 2.5rem;
  }

  h1 {
    max-width: 760px;
    margin: 0 0 0.75rem;
    color: #fffdf4;
    font-family: var(--font-display);
    font-size: clamp(3.2rem, 8vw, 6.25rem);
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.02;
    text-shadow: 0 2px 24px rgba(3, 26, 28, 0.3);
  }

  p {
    max-width: 38rem;
    margin: 0;
    color: rgba(255, 253, 244, 0.78);
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    line-height: 1.6;
  }

  @media (max-width: 800px) {
    .page-hero__content,
    .page-hero__content--wide {
      width: min(100% - 40px, 680px);
    }
  }

  @media (max-width: 560px) {
    .page-hero {
      min-height: max(36rem, 72svh);
    }

    .page-hero--compact {
      min-height: max(24rem, 48svh);
    }

    .page-hero__content,
    .page-hero__content--wide {
      width: calc(100% - 32px);
      padding-top: 9rem;
      padding-bottom: 5.5rem;
    }

    .page-hero--compact .page-hero__content {
      padding-bottom: 2rem;
    }

    h1 {
      font-size: clamp(3rem, 15vw, 4.4rem);
    }

    p {
      max-width: 30rem;
      font-size: 1rem;
    }
  }
</style>
